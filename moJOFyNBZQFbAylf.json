        "jsCode": "const thread_id = $input.first().json.thread_id;\nconst emails = $input.all().map(item => ({\n  date: item.json.date,\n  from: item.json.from,\n  subject: item.json.subject,\n  body: item.json.body,\n  raw: item.json.raw\n}));\n\nreturn [{ json: { thread_id, emails: JSON.stringify(emails, null, 2) } }];"
