    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  // Récupère le XML (soit binary, soit json string)\n  let xml = '';\n  if (item.binary?.data?.data) {\n    xml = Buffer.from(item.binary.data.data, 'base64').toString();\n  } else if (typeof item.json === 'string') {\n    xml = item.json;\n  } else {\n    xml = JSON.stringify(item.json);\n  }\n  \n  // Regex plus permissive pour capturer les items\n  const itemRegex = /<item[^>]*>([\\s\\S]*?)<\\/item>/gi;\n  const items = xml.match(itemRegex);\n  \n  if (items && items.length > 0) {\n    for (let i = 0; i < Math.min(items.length, 10); i++) {\n      const itemXml = items[i];\n      \n      // Extraction simple\n      const titleMatch = itemXml.match(/<title>(?:<!\\[CDATA\\[)?(.*?)(?:\\]\\]>)?<\\/title>/s);\n      const linkMatch = itemXml.match(/<link>([^<]*)<\\/link>/s);\n      const pubDateMatch = itemXml.match(/<pubDate>([^<]*)<\\/pubDate>/s);\n      const descMatch = itemXml.match(/<description>(?:<!\\[CDATA\\[)?(.*?)(?:\\]\\]>)?<\\/description>/s);\n      \n      const title = titleMatch ? titleMatch[1].trim() : '';\n      const link = linkMatch ? linkMatch[1].trim() : '';\n      const pubDate = pubDateMatch ? pubDateMatch[1].trim() : '';\n      const description = descMatch ? descMatch[1].replace(/<[^>]*>/g, '').trim().substring(0, 500) : '';\n      \n      if (title && link) {\n        results.push({\n          json: {\n            title,\n            link,\n            description,\n            pubDate,\n            source: 'Google News'\n          }\n        });\n      }\n    }\n  }\n}\n\nreturn results;"
      },
