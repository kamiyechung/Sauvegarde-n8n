        "parameters": {
          "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  try {\n    const analysis = JSON.parse(item.json.response);\n    results.push({\n      json: {\n        ...item.json,\n        resume: analysis.resume,\n        tags: analysis.tags,\n        priorite: analysis.priorite\n      }\n    });\n  } catch (e) {\n    results.push({\n      json: {\n        ...item.json,\n        resume: item.json.response || '',\n        tags: [],\n        priorite: 'Moyenne'\n      }\n    });\n  }\n}\n\nreturn results;"
