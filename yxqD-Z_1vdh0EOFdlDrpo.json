    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyse cet article et réponds UNIQUEMENT avec un JSON valide (sans markdown, sans balises) :\n\nTitre : {{$json.title}}\nDescription : {{$json.description}}\nSource : {{$json.source}}\n\nRéponds au format :\n{\"resume\": \"résumé en 2-3 phrases\", \"tags\": [\"tag1\", \"tag2\"], \"priorite\": \"Haute|Moyenne|Basse\"}\n\nTags possibles : IA, Meal Planning, Startup, Tech, Marketing\n\nPriorité :\n- Haute : concurrent, innovation majeure, réglementation\n- Moyenne : tendance intéressante\n- Basse : info générale",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
