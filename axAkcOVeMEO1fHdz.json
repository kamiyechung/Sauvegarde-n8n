    "nodes": [
      {
        "id": "wh-orch-1",
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          250,
          300
        ],
        "parameters": {
          "httpMethod": "POST",
          "path": "etat-des-lieux",
          "responseMode": "responseNode",
          "options": {
            "allowedOrigins": ""
          }
        },
        "webhookId": "95931796-1d99-4245-b0df-eecf4b245340"
      },
      {
        "id": "code-orch-val",
        "name": "Code - Validation",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          470,
          300
        ],
        "parameters": {
          "jsCode": "const body = $input.first().json;\nconst INT_TOKEN = 'edl_int_4Xp8nQfMvW2j';\n\n// Vérification token interne (la requête doit transiter par Agent 6)\nif (!body._intToken || body._intToken !== INT_TOKEN) {\n  throw new Error('Accès non autorisé : appelez /webhook/edl-secure');\n}\ndelete body._intToken;\n\nif (!body.meta?.type || !body.meta?.chambre || !body.meta?.locataire || !body.meta?.date) {\n  throw new Error('Payload invalide : meta manquant (type, chambre, locataire, date)');\n}\nif (!body.pieces || typeof body.pieces !== 'object') {\n  throw new Error('Payload invalide : pieces manquant');\n}\nreturn [{ json: body }];"
        }
      },
      {
        "id": "code-orch-sep",
        "name": "Code - Séparer photos",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          690,
          300
        ],
        "parameters": {
          "jsCode": "const body = $input.first().json;\nconst dataPayload = JSON.parse(JSON.stringify(body));\nconst photoPayload = [];\nfor (const [roomId, room] of Object.entries(dataPayload.pieces)) {\n  for (const [elemKey, elem] of Object.entries(room.elements || {})) {\n    if (elem.photos && elem.photos.length > 0) {\n      photoPayload.push({ roomId, elemKey, photos: elem.photos, meta: body.meta });\n      dataPayload.pieces[roomId].elements[elemKey].photos = [];\n    }\n  }\n}\nreturn [{ json: { dataPayload, photoPayload } }];"
        }
      },
      {
        "id": "if-orch-photos",
        "name": "IF - Photos ?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          910,
          300
        ],
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict"
            },
            "conditions": [
              {
                "id": "cond-photos",
                "leftValue": "={{ $json.photoPayload.length }}",
                "rightValue": 0,
                "operator": {
                  "type": "number",
                  "operation": "gt"
                }
              }
            ],
            "combinator": "and"
          }
        }
      },
      {
        "id": "http-orch-photos",
        "name": "HTTP Request - edl-photos",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1130,
          180
        ],
        "parameters": {
          "method": "POST",
          "url": "https://n8n.checkintrust.com/webhook/edl-photos",
          "sendBody": true,
          "contentType": "json",
          "body": "={{ JSON.stringify({ photoPayload: $json.photoPayload, meta: $json.dataPayload.meta }) }}",
          "options": {
            "timeout": 120000
          }
        }
      },
      {
        "id": "code-orch-merge",
        "name": "Code - Merge URLs",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1350,
          180
        ],
        "parameters": {
          "jsCode": "const photoResponse = $input.first().json;\nconst dataPayload = $('Code - Séparer photos').first().json.dataPayload;\nif (Array.isArray(photoResponse)) {\n  for (const item of photoResponse) {\n    const room = dataPayload.pieces[item.roomId];\n    if (room && room.elements && room.elements[item.elemKey]) {\n      room.elements[item.elemKey].photoUrls = item.urls;\n    }\n  }\n}\nreturn [{ json: dataPayload }];"
        }
      },
      {
        "id": "code-orch-norm",
        "name": "Code - Normaliser",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1570,
          300
        ],
        "parameters": {
          "jsCode": "const item = $input.first().json;\n// Chemin avec photos : item = dataPayload (flat, a meta directement)\n// Chemin sans photos : item = { dataPayload, photoPayload } (wrappé)\nconst data = (item.meta !== undefined) ? item : (item.dataPayload || item);\nreturn [{ json: data }];"
        }
      },
      {
        "id": "http-orch-notion",
        "name": "HTTP Request - edl-notion",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1790,
          300
        ],
        "parameters": {
          "method": "POST",
          "url": "https://n8n.checkintrust.com/webhook/edl-notion",
          "sendBody": true,
          "contentType": "json",
          "body": "={{ JSON.stringify($json) }}",
          "options": {
            "timeout": 60000
          }
        }
      },
      {
        "id": "http-orch-docuseal",
        "name": "HTTP Request - edl-docuseal",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          2010,
          300
        ],
        "parameters": {
          "method": "POST",
          "url": "https://n8n.checkintrust.com/webhook/edl-docuseal",
          "sendBody": true,
          "contentType": "json",
          "body": "={{ JSON.stringify($('Code - Normaliser').first().json) }}",
          "options": {
            "timeout": 60000
          }
        },
        "onError": "continueRegularOutput"
      },
      {
        "id": "resp-orch-ok",
        "name": "Respond to Webhook",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          2230,
          300
        ],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={ \"success\": true }",
          "options": {
            "responseHeaders": {
              "entries": [
                {
                  "name": "Access-Control-Allow-Origin",
                  "value": ""
                }
              ]
            }
          }
        }
      },
      {
        "id": "code-orch-err",
        "name": "Code - Erreur",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1130,
          480
        ],
        "parameters": {
          "jsCode": "return [{ json: { success: false, error: $input.first().json.message || 'Erreur inconnue' } }];"
        }
      },
      {
        "id": "resp-orch-err",
        "name": "Respond to Webhook - Erreur",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          1350,
          480
        ],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ JSON.stringify($json) }}",
          "options": {
            "responseCode": 500,
            "responseHeaders": {
              "entries": [
                {
