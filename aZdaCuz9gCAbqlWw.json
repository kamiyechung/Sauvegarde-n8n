    },
    {
      "parameters": {
        "jsCode": "const today = new Date().toISOString().split('T')[0];\nfor (const item of $input.all()) {\n  const props = item.json.properties;\n  const status = props?.State?.status?.name || '';\n  const date = props?.Date?.date?.start || '';\n  if (status === 'Planifié' && date === today) return [item];\n}\nreturn [];"
      },
      "id": "4bc032aa-9e61-4057-9970-93f4003354b6",
      "name": "Filtrer post du jour",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1952,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "const props = $input.item.json.properties;\nconst type = props?.Type?.select?.name || 'image';\nconst files = props?.['Files & media']?.files || [];\nconst fileUrl = files[0]?.file?.url || '';\nconst fileName = files[0]?.name || 'file';\nconst postText = (props?.['Post text']?.rich_text || []).map(b => b.plain_text).join('');\nconst notionPageId = $input.item.json.id;\nreturn [{ json: { type, fileUrl, fileName, postText, notionPageId } }];"
      },
      "id": "cdb6ed82-694e-40af-812c-657fb7de2a4e",
      "name": "Extraire données",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2176,
        144
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.fileUrl }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "c990e108-11b9-4b68-b1ef-b82e980f8c2f",
      "name": "Télécharger le fichier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2384,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "const type = $('Extraire données').item.json.type;\nconst isCarousel = type.toLowerCase() === 'carrousel';\nreturn [{ json: { ...($('Extraire données').item.json), isCarousel, recipe: isCarousel ? 'urn:li:digitalmediaRecipe:feedshare-document' : 'urn:li:digitalmediaRecipe:feedshare-image' }, binary: $input.item.binary }];"
      },
      "id": "0eeb9d40-456f-408b-bfde-31064a14f4f7",
      "name": "Définir type upload",
      "type": "n8n-nodes-base.code",
