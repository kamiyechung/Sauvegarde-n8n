      },
      "id": "2db8bbe9-c7f1-4efb-bf68-b39ee8b446fa",
      "name": "LinkedIn – Upload fichier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3264,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Préparer upload URL').item.json;\nconst isCarousel = prev.isCarousel;\nlet specificContent;\nif (isCarousel) {\n  specificContent = {\n    'com.linkedin.ugc.ShareContent': {\n      shareCommentary: { text: prev.postText },\n      shareMediaCategory: 'DOCUMENT',\n      media: [{ status: 'READY', media: prev.asset, title: { text: prev.fileName } }]\n    }\n  };\n} else {\n  specificContent = {\n    'com.linkedin.ugc.ShareContent': {\n      shareCommentary: { text: prev.postText },\n      shareMediaCategory: 'IMAGE',\n      media: [{ status: 'READY', media: prev.asset }]\n    }\n  };\n}\nconst body = {\n  author: 'urn:li:person:VOTRE_ID_LINKEDIN',\n  lifecycleState: 'PUBLISHED',\n  specificContent,\n  visibility: { 'com.linkedin.ugc.MemberNetworkVisibility': 'PUBLIC' }\n};\nreturn [{ json: { body, notionPageId: prev.notionPageId } }];"
      },
