      "position": [
        2608,
        144
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/v2/assets?action=registerUpload",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Restli-Protocol-Version",
              "value": "2.0.0"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ registerUploadRequest: { recipes: [$json.recipe], owner: 'urn:li:person:VOTRE_ID_LINKEDIN', serviceRelationships: [{ relationshipType: 'OWNER', identifier: 'urn:li:userGeneratedContent' }] } }) }}",
        "options": {}
      },
      "id": "d2461782-9cb4-4687-a545-f568cf4d4b41",
      "name": "LinkedIn – Enregistrer upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2832,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "const registerData = $input.item.json;\nconst uploadUrl = registerData.value.uploadMechanism['com.linkedin.digitalmedia.uploading.MediaUploadHttpRequest'].uploadUrl;\nconst asset = registerData.value.asset;\nconst prev = $('Définir type upload').item.json;\nreturn [{ json: { ...prev, uploadUrl, asset }, binary: $('Définir type upload').item.binary }];"
      },
      "id": "8ab870d7-8f26-4b09-976a-b4a6f391243d",
      "name": "Préparer upload URL",
