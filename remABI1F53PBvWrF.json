        -1040,
        -160
      ]
    },
    {
      "parameters": {
        "jsCode": "const html = $input.item.json;\nconst cheerio = require('cheerio');\nconst $ = cheerio.load(html);\n\nconst results = [];\n\n$('.product-card').each((i, elem) => {\n  const name = $(elem).find('.product-name').text().trim();\n  const priceText = $(elem).find('.product-price').text().trim();\n  const price = parseFloat(priceText.replace(',', '.').replace(/[^0-9.]/g, ''));\n  const unit = $(elem).find('.product-unit').text().trim();\n  const promo = $(elem).find('.product-discount').text().trim();\n  const image = $(elem).find('.product-image img').attr('src');\n  const ean = $(elem).attr('data-ean') || '';\n  \n  if (name && price) {\n    results.push({\n      ingredient_id: $('$node[\"Loop produits\"].json[\"id\"]'),\n      searched_name: $('$node[\"Loop produits\"].json[\"product_name\"]'),\n      found_name: name,\n      price: price,\n      unit: unit,\n      promo: promo || null,\n      image_url: image,\n      ean: ean,\n      store: 'leclerc',\n      scraped_at: new Date().toISOString()\n    });\n  }\n});\n\nif (results.length === 0) {\n  return [{\n    json: {\n      ingredient_id: $('$node[\"Loop produits\"].json[\"id\"]'),\n      error: 'Produit non trouvé',\n      searched_name: $('$node[\"Loop produits\"].json[\"product_name\"]')\n    }\n  }];\n}\n\nreturn results.map(r => ({json: r}));"
      },
