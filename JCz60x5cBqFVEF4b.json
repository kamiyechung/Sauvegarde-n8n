      "parameters": {
        "jsCode": "// Fonction pour nettoyer le HTML\nfunction cleanHtmlContent(html) {\n  if (!html) return '';\n  \n  return html\n    .replace(/<script\\b[^<]*(?:(?!<\\/script>)<[^<]*)*<\\/script>/gi, '')\n    .replace(/<style\\b[^<]*(?:(?!<\\/style>)<[^<]*)*<\\/style>/gi, '')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\")\n    .replace(/&agrave;/g, 'à')\n    .replace(/&eacute;/g, 'é')\n    .replace(/&egrave;/g, 'è')\n    .replace(/&ecirc;/g, 'ê')\n    .replace(/&icirc;/g, 'î')\n    .replace(/&ocirc;/g, 'ô')\n    .replace(/&ucirc;/g, 'û')\n    .replace(/&ccedil;/g, 'ç')\n    .replace(/&#231;/g, 'ç')\n    .replace(/&#(\\d+);/g, (match, dec) => String.fromCharCode(dec))\n    .replace(/&zwnj;/g, '')\n    .replace(/&shy;/g, '')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\n// Traiter les items\nreturn $input.all().map(item => {\n  const htmlContent = item.json.html || item.json.body || '';\n  const cleanedText = cleanHtmlContent(htmlContent);\n  \n  return {\n    json: {\n      id: item.json.id,\n      from: item.json.from?.value?.[0]?.address || item.json.from,\n      from_name: item.json.from?.value?.[0]?.name || '',\n      subject: item.json.subject || '',\n      labelIds: item.json.labelIds || [],\n      date: item.json.date,\n      extrait: cleanedText.substring(0, 2000)\n    }\n  };\n});"
      },
