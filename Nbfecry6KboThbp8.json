      {
        "id": "code-loc-1",
        "name": "Code - Formater liste",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2010,
          180
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const { parties, baux } = $('Code - Collecter Baux').first().json;\nconst chambreItems = $input.all();\n\nfunction norm(id) { return id ? String(id).replace(/-/g, '') : ''; }\n\nconst chambreMap = {};\nfor (const c of chambreItems) {\n  const numStr = c.json.property_num_ro_chambre || c.json.property_nom || '';\n  const num = parseInt(numStr.replace(/\\D/g, ''));\n  if (!isNaN(num) && num > 0) chambreMap[norm(c.json.id)] = num;\n}\n\nconst locataireChambreMap = {};\nfor (const b of baux) {\n  if (b.property_etat !== 'Actif') continue;\n  let locataireId = b.property_locataires;\n  let chambreId = b.property_chambres;\n  if (Array.isArray(locataireId)) locataireId = locataireId[0];\n  if (Array.isArray(chambreId)) chambreId = chambreId[0];\n  if (typeof locataireId === 'object' && locataireId) locataireId = locataireId.id || null;\n  if (typeof chambreId === 'object' && chambreId) chambreId = chambreId.id || null;\n  const chamNum = chambreMap[norm(chambreId)];\n  if (locataireId && chamNum) locataireChambreMap[norm(locataireId)] = chamNum;\n}\n\nconst locataires = parties\n  .filter(p => p.property_statut === 'Locataire')\n  .map(p => ({\n    nom: (p.property_name || '').trim(),\n    id: p.id,\n    email: p.property_email || '',\n    edlEntree: p.property_etat_des_lieux_d_entr_e || 'Pas fait',\n    edlSortie: p.property_etat_des_lieux_de_sortie || 'Pas fait',\n    chambre: locataireChambreMap[norm(p.id)] || null,\n    dossierDrive: p.property_lien_de_stockage_des_documents || null\n  }))\n  .filter(l => l.nom);\n\nlocataires.sort((a, b) => a.nom.localeCompare(b.nom, 'fr'));\nreturn [{ json: { locataires } }];"
        }
      },
