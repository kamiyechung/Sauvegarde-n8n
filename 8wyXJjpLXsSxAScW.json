    {
      "parameters": {
        "jsCode": "const recipeIngredients = $input.all();\n\nfunction toSingular(word) {\n  word = String(word || '').toLowerCase().trim();\n  \n  if (!word) return '';\n  \n  const exceptions = {\n    'pommes de terre': 'pomme de terre',\n    'oeufs': 'oeuf',\n    'noix': 'noix'\n  };\n  \n  if (exceptions[word]) return exceptions[word];\n  \n  if (word.endsWith('aux')) return word.slice(0, -3) + 'al';\n  if (word.endsWith('eux')) return word.slice(0, -3) + 'eu';\n  if (word.endsWith('s')) return word.slice(0, -1);\n  \n  return word;\n}\n\nfunction mapIngredient(name) {\n  const mapping = {\n    'sucre': 'sucre blanc',\n    'farine': 'farine de blé',\n    'huile': 'huile d\\'olive'\n  };\n  \n  return mapping[name] || name;\n}\n\nreturn recipeIngredients.map(item => {\n  const name = String(item.json?.name || '');\n  const singular = toSingular(name);\n  const mapped = mapIngredient(singular);\n  \n  return {\n    json: {\n      search_term: mapped,\n      original_name: name,\n      quantity: item.json?.quantity,\n      unit: item.json?.unit,\n      recipe_title: item.json?.recipe_title\n    }\n  };\n});"
      },
      "id": "156d70b3-60b6-4ede-bfe6-327ee0cfb170",
      "name": "Normalize ingredient",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -16
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const matchedIngredients = $input.all();\n\nreturn [{\n  json: {\n    matched_ingredients: matchedIngredients.map(item => ({\n      name: item.json.ingredient_name || item.json.name,\n      quantity: item.json.quantity,\n      unit: item.json.unit,\n      _type: \"ingredient\",\n      recipe_title: item.json.recipe_title,\n      ingredient_id: item.json.ingredient_id\n    }))\n  }\n}];"
      },
