    {
      "parameters": {
        "functionCode": "const dateDebut = new Date($input.item.json['date:Date de début de location:start']);\nconst mois = dateDebut.getMonth() + 1;\nconst annee = dateDebut.getFullYear();\n\nlet trimestre;\nif (mois >= 1 && mois <= 3) trimestre = `T4 ${annee - 1}`;\nelse if (mois >= 4 && mois <= 6) trimestre = `T1 ${annee}`;\nelse if (mois >= 7 && mois <= 9) trimestre = `T2 ${annee}`;\nelse trimestre = `T3 ${annee}`;\n\nreturn {\n  json: {\n    ...$input.item.json,\n    reference_irl: trimestre\n  }\n};"
      },
