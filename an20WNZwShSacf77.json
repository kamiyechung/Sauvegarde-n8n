      {
        "id": "code-sec-auth",
        "name": "Code - Auth + Validation",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          470,
          300
        ],
        "parameters": {
          "jsCode": "const EXT_TOKEN = 'edl_wh_7Kx2mPn9sRtL';\nconst INT_TOKEN = 'edl_int_4Xp8nQfMvW2j';\n\nfunction sanitize(s) {\n  if (s === null || s === undefined) return '';\n  return String(s)\n    .replace(/[<>&\"']/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','\"':'&quot;',\"'\":'&#x27;'}[c]))\n    .replace(/[\\x00-\\x1F\\x7F]/g, '')\n    .trim()\n    .substring(0, 1000);\n}\n\nconst body = JSON.parse(JSON.stringify($input.first().json));\n\n// 1. Vérification du token externe\nif (!body._token || body._token !== EXT_TOKEN) {\n  return [{ json: { _authFailed: true, error: 'Non autorisé' } }];\n}\ndelete body._token;\n\n// 2. Validation du schéma\nconst meta = body.meta;\nif (!meta || !['entree', 'sortie'].includes(meta.type)) {\n  return [{ json: { _authFailed: true, error: 'Type invalide (entree/sortie attendu)' } }];\n}\nif (!meta.chambre || typeof meta.chambre !== 'number' || meta.chambre < 1 || meta.chambre > 99) {\n  return [{ json: { _authFailed: true, error: 'Chambre invalide (1-99)' } }];\n}\nif (!meta.locataire || typeof meta.locataire !== 'string' || meta.locataire.trim().length === 0 || meta.locataire.length > 200) {\n  return [{ json: { _authFailed: true, error: 'Locataire invalide' } }];\n}\nif (!meta.date || !/^\\d{4}-\\d{2}-\\d{2}$/.test(meta.date)) {\n  return [{ json: { _authFailed: true, error: 'Date invalide (YYYY-MM-DD attendu)' } }];\n}\nif (!body.pieces || typeof body.pieces !== 'object' || Array.isArray(body.pieces)) {\n  return [{ json: { _authFailed: true, error: 'Pièces manquantes ou invalides' } }];\n}\n\n// 3. Nettoyage XSS de tous les champs texte\nmeta.locataire = sanitize(meta.locataire);\nif (body.observations) body.observations = sanitize(body.observations);\nfor (const room of Object.values(body.pieces)) {\n  for (const elem of Object.values(room.elements || {})) {\n    if (elem.commentaire) elem.commentaire = sanitize(elem.commentaire);\n    if (elem.etat) elem.etat = sanitize(elem.etat);\n  }\n}\n\n// 4. Injection du token interne (pour Agent 2)\nbody._intToken = INT_TOKEN;\n\nreturn [{ json: body }];"
        }
      },
